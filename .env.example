# AutoSub PureAI - Configuration Variables

# Primary Cloud LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Fallback LLM (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local GPU LLM (Ollama)
OLLAMA_IP=127.0.0.1
OLLAMA_PORT=11434

# Web Dashboard Port
PORT=5055
